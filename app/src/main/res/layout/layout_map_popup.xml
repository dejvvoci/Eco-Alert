<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Kategoria + Mbyll -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/popup_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kategoria"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary" />

            <ImageView
                android:id="@+id/btn_close_popup"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/gray_medium" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_light"
            android:layout_marginBottom="8dp" />

        <!-- Përshkrimi -->
        <TextView
            android:id="@+id/popup_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Përshkrimi..."
            android:textSize="13sp"
            android:textColor="@color/black"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <!-- Data dhe Konfirmimet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="@color/gray_medium"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/popup_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textSize="11sp"
                android:textColor="@color/gray_medium" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_menu_upload"
                app:tint="@color/gray_medium"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/popup_confirmations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 konfirmime"
                android:textSize="11sp"
                android:textColor="@color/gray_medium" />

        </LinearLayout>

        <!-- Butoni Shiko të plota -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_full"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Shiko raportin e plotë"
            android:textSize="13sp"
            app:backgroundTint="@color/green_primary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>